# PreStrokeNet Backend Environment Configuration Example
# Copy this file to Backend/.env and configure for your deployment

# Database Configuration
DB_SERVER=localhost
DB_DATABASE=PreStrokeNet
DB_DRIVER=ODBC Driver 18 for SQL Server
# DATABASE_URL=mssql+pyodbc://username:password@localhost:1433/PreStrokeNet?driver=ODBC+Driver+18+for+SQL+Server

# JWT Security
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_EXPIRE_MINUTES=30

# CORS & Server Environment
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:80
ENVIRONMENT=development

# AI Clinical Decision-Support Assistant
AI_PROVIDER=grounded
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# SMTP Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_INTEGRATION_ENABLED=false
SMTP_TEST_RECIPIENT=

# Branding
HOSPITAL_NAME="PreStrokeNet Clinical Intelligence"
HOSPITAL_LOGO_PATH=""
